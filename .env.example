# Names only, never values. This file is committed on purpose; .env is ignored.
#
# These are the *bootstrap* layer — the credentials the stack needs before anything is
# running. D33 rules that operational credentials for the pipeline (the CWA open-data key,
# and the pipeline's own database access) become Airflow Connections, encrypted in Airflow's
# metadata database, and never appear here. The API's database URL is assembled from these
# by compose, because the API cannot read an Airflow Connection.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# The one port published to the host. Defaults to 8080 when unset.
UPTO_HTTP_PORT=

# Airflow's own bootstrap layer, and this is the whole of it (D33). Everything the DAGs
# use — the CWA key, the application database — is an Airflow Connection instead, created
# once by the init service and stored Fernet-encrypted in Airflow's metadata database.
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=
# Signs the tokens workers present to the Execution API. Every Airflow container must
# share it, or a task fails with "Invalid auth token: Signature verification failed".
AIRFLOW_JWT_SECRET=
# Read once at init to create the Connection, never read by a task.
UPTO_CWA_API_KEY=

# The orchestrator UI. Defaults to 8081 when unset.
AIRFLOW_HTTP_PORT=
